# Add this variable to your private local .env file.
# Use a Google AI Studio project on the Free Tier with billing disabled.
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=False

# Custom admin login (run: python manage.py sync_env_admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-chars
ADMIN_EMAIL=admin@health.in

# Appointment fee in INR. Set to blank to disable charges.
APPOINTMENT_FEE=50
# Razorpay
RAZORPAY_KEY_ID=rzp_test_replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace_with_test_key_secret

